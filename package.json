{
"name": "manfaz-final",
  "version": "1.0.0",
  "author": "Your Name",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
"dist": "electron-packager . --platform=win32 --arch=x64 --out=dist --overwrite --electron-version=28.0.0"
  },
  "build": {
    "appId": "com.manfaz.final",
    "productName": "منفذ خريطة",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@noble/hashes": "^1.3.1",
    "app-builder-lib": "^26.15.3",
    "electron-packager": "^17.1.2"
  }
}
